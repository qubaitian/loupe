{
  "name": "loupe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "node scripts/fonts.ts",
    "predev": "npm run fonts",
    "prebuild": "npm run fonts",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=server server/main.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "check": "svelte-check --workspace web && tsc -p server",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "monaco-editor": "^0.57.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
